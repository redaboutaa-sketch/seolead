# SEO Lead Factory — environment template.
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every value here is a PLACEHOLDER. No real credential belongs in this file.

# ─── Application ──────────────────────────────────────────────────────────────
SEOLEAD_ENV=dev
SEOLEAD_LOG_LEVEL=INFO

# Shared secret protecting the internal API (approval, pipeline triggers).
# Generate with:  openssl rand -hex 32
SEOLEAD_INTERNAL_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_HEX_STRING

# ─── Database ─────────────────────────────────────────────────────────────────
# Dedicated `seolead` database and least-privilege `seolead_app` role inside the
# existing PostgreSQL engine (container `platform_postgres`). Created by
# scripts/create_database.sh — see docs/runbooks/LOCAL_PIPELINE.md.
# From inside the seolead_backend network the host is the container name.
SEOLEAD_DATABASE_URL=postgresql+asyncpg://seolead_app:CHANGE_ME@platform_postgres:5432/seolead

# ─── Last30Days research runner ───────────────────────────────────────────────
# Internal DNS name of the SEO Lead Factory's OWN runner. Never the ChainPilot one.
SEOLEAD_LAST30DAYS_URL=http://seolead_last30days:8080
SEOLEAD_LAST30DAYS_TIMEOUT_SECONDS=600
SEOLEAD_LAST30DAYS_WINDOW_DAYS=30
SEOLEAD_LAST30DAYS_MAX_RESULTS=100

# Engine source keys. ABSENT IS A VALID STATE: a source without a key reports
# `skipped-unconfigured`, which is information — never "0 results".
# Leave blank until you have a real key.
SERPER_API_KEY=
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# ─── LLM provider ─────────────────────────────────────────────────────────────
# Phase 2 runs end-to-end without these. With no key the pipeline stops cleanly
# at LLM_NOT_CONFIGURED after producing the ResearchPackage and deterministic brief.
SEOLEAD_LLM_PROVIDER=openai_compatible
SEOLEAD_LLM_API_KEY=
SEOLEAD_LLM_BASE_URL=https://api.openai.com/v1
SEOLEAD_LLM_MODEL=gpt-4o-mini
SEOLEAD_LLM_TIMEOUT_SECONDS=120
SEOLEAD_LLM_MAX_RETRIES=2
