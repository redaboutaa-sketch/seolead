# SEO Lead Factory — environment template.
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every value here is a PLACEHOLDER. No real credential belongs in this file.

# ─── Application ──────────────────────────────────────────────────────────────
SEOLEAD_ENV=dev
SEOLEAD_LOG_LEVEL=INFO

# Shared secret protecting the internal API (approval, pipeline triggers).
# Generate with:  openssl rand -hex 32
SEOLEAD_INTERNAL_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_HEX_STRING

# ─── Database ─────────────────────────────────────────────────────────────────
# Dedicated `seolead` database and least-privilege `seolead_app` role inside the
# existing PostgreSQL engine (container `platform_postgres`). Created by
# scripts/create_database.sh — see docs/runbooks/LOCAL_PIPELINE.md.
# From inside the seolead_backend network the host is the container name.
SEOLEAD_DATABASE_URL=postgresql+asyncpg://seolead_app:CHANGE_ME@platform_postgres:5432/seolead

# ─── Last30Days research runner ───────────────────────────────────────────────
# Internal DNS name of the SEO Lead Factory's OWN runner. Never the ChainPilot one.
SEOLEAD_LAST30DAYS_URL=http://seolead_last30days:8080
SEOLEAD_LAST30DAYS_TIMEOUT_SECONDS=600
SEOLEAD_LAST30DAYS_WINDOW_DAYS=30
SEOLEAD_LAST30DAYS_MAX_RESULTS=100

# Engine source keys. ABSENT IS A VALID STATE: a source without a key reports
# `skipped-unconfigured`, which is information — never "0 results".
# Leave blank until you have a real key.
SERPER_API_KEY=
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# ─── DataForSEO — Search Intelligence (SERP, keyword metrics) ────────────────
# API password from https://app.dataforseo.com/api-access — NOT your account
# password. See docs/runbooks/PROVIDER_CREDENTIALS.md for a procedure that never
# echoes the value.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_TIMEOUT_SECONDS=120
DATAFORSEO_SERP_DEPTH=20

# ─── Tavily — Web Research (the factual evidence set) ────────────────────────
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=120
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=advanced

# ─── Research freshness (hours) ──────────────────────────────────────────────
# SERPs move daily; explanatory pages do not. `--force-refresh` always overrides.
SEOLEAD_SERP_TTL_HOURS=24
SEOLEAD_WEB_RESEARCH_TTL_HOURS=168
SEOLEAD_COMMUNITY_TTL_HOURS=72

# ─── Cost control ────────────────────────────────────────────────────────────
# Per-job ceiling per provider, enforced BEFORE each request. A runaway loop hits
# this, not an invoice.
SEOLEAD_MAX_CALLS_PER_PROVIDER=3

# ─── Relevance gate ──────────────────────────────────────────────────────────
# Not validated against a labelled corpus. Chosen so the Phase 2 racing-game
# failure is rejected and obvious good cases pass. Tune against real rejections.
SEOLEAD_RELEVANCE_RELEVANT_AT=0.55
SEOLEAD_RELEVANCE_LOW_AT=0.30
SEOLEAD_RELEVANCE_SEMANTIC_ENABLED=true

# ─── LLM provider ─────────────────────────────────────────────────────────────
# Phase 2 runs end-to-end without these. With no key the pipeline stops cleanly
# at LLM_NOT_CONFIGURED after producing the ResearchPackage and deterministic brief.
SEOLEAD_LLM_PROVIDER=openai_compatible
SEOLEAD_LLM_API_KEY=
SEOLEAD_LLM_BASE_URL=https://api.openai.com/v1
SEOLEAD_LLM_MODEL=gpt-4o-mini
SEOLEAD_LLM_TIMEOUT_SECONDS=120
SEOLEAD_LLM_MAX_RETRIES=2

# ─── Site staging (Phase 4) ──────────────────────────────────────────────────
# Which site configuration under config/sites/ this deployment serves.
SEOLEAD_SITE_ID=solar_be

# A SECOND secret, independent of SEOLEAD_INTERNAL_API_KEY, required by the
# preview route. Preview is the only path that serves unpublished content, and it
# is shared with whoever reviews a page — which is a wider audience than whoever
# may trigger paid research. Unset means the preview route refuses to serve.
SEOLEAD_SITE_PREVIEW_TOKEN=

# Salt for the ephemeral hash of a submitter's IP. The hash exists only to bucket
# form submissions for rate limiting and is never stored with the lead.
SEOLEAD_CLIENT_KEY_SALT=

# Edge credential for /preview paths once the site has a public hostname.
#
# SEOLEAD_SITE_PREVIEW_TOKEN authenticates the WEB SERVER to the API. It says
# nothing about who is holding the browser, which is fine on loopback and not
# fine on a public domain. This authenticates the VISITOR, at Traefik, before the
# request reaches an app that would render a staged page.
#
# Format: user:apr1-hash, with every $ doubled for compose interpolation:
#   printf '%s:%s\n' user "$(openssl passwd -apr1)" | sed 's/\$/$$/g'
SEOLEAD_PREVIEW_BASICAUTH_USER=
SEOLEAD_PREVIEW_BASICAUTH_PASSWORD=
SEOLEAD_PREVIEW_BASICAUTH=

# ─── COMPOSE_FILE — ce qui publie le site, et pourquoi c'est ici ──────────────
#
# Le routage public de monprojetsolaire.be vit dans un overlay séparé,
# `infra/traefik/docker-compose.public.yml`, pour que publier reste un acte
# délibéré : un `docker compose up -d` ordinaire ne doit pas mettre un site en
# ligne tout seul.
#
# Cette prudence a un revers, mesuré le 2026-08-18 : une fois le site
# DÉLIBÉRÉMENT publié, un `docker compose up -d` ordinaire — sans les deux
# `-f` — recrée `seolead_web` SANS les étiquettes Traefik et SANS le réseau
# `traefik-public`. Traefik n'a alors plus aucune route pour l'hôte et répond
# son propre 404. Le site disparaît en silence : les conteneurs restent
# « healthy », l'application répond correctement en interne, et rien n'échoue.
# C'est exactement ce qui s'est produit lorsque le conteneur a été recréé le
# 2026-08-17 à 08:56.
#
# Une fois la publication décidée et le DNS vérifié, renseigner COMPOSE_FILE :
# docker compose lit alors les deux fichiers pour TOUTE commande, y compris
# celles qu'on tape sans réfléchir.
#
#   COMPOSE_FILE=docker-compose.yml:infra/traefik/docker-compose.public.yml
#
# Laisser vide tant que le DNS ne pointe pas vers cette machine : une demande
# de certificat TLS-ALPN-01 sur un DNS erroné échoue et compte dans les quotas
# Let's Encrypt.
COMPOSE_FILE=
